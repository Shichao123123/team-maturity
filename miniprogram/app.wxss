/** 中钢安环院：深蓝 + 中钢红，冶金安全机构气质 **/
page {
  --ink: #0f2438;
  --steel: #0b3a5c;
  --brand-red: #c8102e;
  --teal: #0d6e5f;
  --mist: #e6eef5;
  --panel: rgba(255, 255, 255, 0.94);
  --line: #c5d3e0;
  --muted: #5f7385;
  --warn: #b45309;
  --danger: #b42318;
  --ok: #0d6e5f;
  --radius: 16rpx;
  --shadow: 0 10rpx 32rpx rgba(11, 58, 92, 0.12);

  background: var(--mist);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: #061526
    linear-gradient(165deg, #0a2744 0%, #123a5c 42%, #0d4a4a 100%);
}

.page-bg-img {
  width: 100%;
  height: 100%;
  opacity: 0.42;
}

.page-bg-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(6, 21, 38, 0.55) 0%,
    rgba(6, 21, 38, 0.72) 45%,
    rgba(6, 21, 38, 0.88) 100%
  );
}

.page-body {
  position: relative;
  z-index: 1;
}

.org-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.org-logo {
  width: 100%;
  height: 72rpx;
}

.org-logo--sm {
  height: 56rpx;
}

.org-bar--compact {
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.org-bar-text {
  flex: 1;
  min-width: 0;
}

.org-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.04em;
}

.org-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.62);
}

.hero {
  padding: 8rpx 4rpx 28rpx;
}

.hero-panel {
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
  min-height: 220rpx;
  background: #0b3a5c;
}

.hero-panel-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.55;
}

.hero-panel-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    120deg,
    rgba(6, 24, 42, 0.88) 0%,
    rgba(11, 58, 92, 0.55) 55%,
    rgba(200, 16, 46, 0.28) 100%
  );
}

.hero-panel-body {
  position: relative;
  z-index: 1;
  padding: 28rpx 28rpx 32rpx;
}

.brand {
  font-size: 22rpx;
  letter-spacing: 0.14em;
  color: rgba(255, 214, 180, 0.9);
  font-weight: 600;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #fff;
  line-height: 1.25;
}

.hero-sub {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
}

.card {
  background: var(--panel);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx;
  margin-bottom: 24rpx;
  backdrop-filter: blur(8px);
}

.card-title {
  font-size: 30rpx;
  font-weight: 650;
  margin-bottom: 16rpx;
  color: var(--ink);
}

.label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.field {
  background: #f4f7fa;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  min-height: 88rpx;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-arrow {
  color: #8fa0b0;
  font-size: 36rpx;
  line-height: 1;
}

.field-input {
  width: 100%;
  height: 44rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.picker-value {
  font-size: 30rpx;
  color: var(--ink);
}

.picker-placeholder {
  color: #8fa0b0;
}

.btn {
  margin-top: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0 32rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #0b3a5c 0%, #145a8a 100%);
  color: #fff;
}

.btn-primary[disabled] {
  background: #9db4c7;
  color: #fff;
}

.btn-teal {
  background: linear-gradient(135deg, #0d6e5f 0%, #14967f 100%);
  color: #fff;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.92);
  color: var(--steel);
  border: 2rpx solid rgba(11, 58, 92, 0.35);
  line-height: 88rpx;
}

.btn-block {
  width: 100%;
}

.muted {
  color: var(--muted);
}

.tip {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.empty {
  text-align: center;
  padding: 80rpx 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.page--light .empty {
  color: var(--muted);
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #e6f2ef;
  color: var(--teal);
}

.tag-warn {
  background: #fff3e0;
  color: var(--warn);
}

.tag-done {
  background: #e8f5e9;
  color: #2e7d32;
}

.score-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--steel);
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 浅色内容页（答题）：减弱背景图干扰 */
.page--light .page-bg-img {
  opacity: 0.18;
}

.page--light .page-bg-mask {
  background: linear-gradient(
    180deg,
    rgba(232, 238, 242, 0.88) 0%,
    rgba(232, 238, 242, 0.94) 100%
  );
}

.page--light .hero-title {
  color: var(--ink);
}

.page--light .hero-sub {
  color: var(--muted);
}

.page--light .brand {
  color: var(--brand-red);
}

.brand-footer {
  margin-top: 40rpx;
  padding: 28rpx 16rpx 12rpx;
  text-align: center;
}

.brand-footer-copy {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.4;
}

.brand-footer-site {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 0.02em;
}

/* 浅底页面（答题内容区） */
.brand-footer.light .brand-footer-copy,
.brand-footer.light .brand-footer-site {
  color: #8fa0b0;
}

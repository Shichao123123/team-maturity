.empty-in-card {
  color: var(--muted);
  padding: 48rpx 16rpx;
}

.rule-list {
  margin-top: 4rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #e8eef2;
}

.rule-item:first-child {
  border-top: none;
  padding-top: 0;
}

.rule-no {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 10rpx;
  background: rgba(27, 79, 114, 0.1);
  color: var(--steel);
  font-size: 22rpx;
  font-weight: 650;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.rule-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--ink);
}

.notice-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: rgba(180, 83, 9, 0.06);
}

.notice-title {
  font-size: 26rpx;
  font-weight: 650;
  color: var(--warn);
  margin-bottom: 10rpx;
}

.notice-box .tip {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.batch-item {
  padding: 24rpx 0;
  border-top: 1rpx solid #e4ebf0;
}

.batch-item:first-of-type {
  border-top: none;
  padding-top: 8rpx;
}

.batch-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  max-width: 480rpx;
}

.batch-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.dot {
  margin: 0 10rpx;
}
